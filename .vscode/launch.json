{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Siau Wei AI Chatbot Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "Compile Extension"
    }
  ]
}